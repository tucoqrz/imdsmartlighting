{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "💡 Brilho dos Postes",
      "description": "Nível de brilho (0-100) de cada poste",
      "type": "timeseries",
      "gridPos": { "h": 14, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Brilho (%)",
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('second', time_index) AS \"time\", entity_id, MAX(CASE WHEN ambient_light > 400 THEN 0 WHEN motion_detected = true THEN 100 ELSE 20 END) AS brightness FROM mtimdlampservice.etlamp WHERE $__timeFilter(time_index) AND ambient_light IS NOT NULL AND motion_detected IS NOT NULL GROUP BY 1, 2 ORDER BY 1 ASC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "🌙 Luminosidade Ambiente",
      "description": "Nível de luz ambiente (lux) captado pelo sensor de cada poste",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Lux",
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0,
          "unit": "lux"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('second', time_index) AS \"time\", entity_id, MAX(ambient_light) AS ambient_light FROM mtimdlampservice.etlamp WHERE $__timeFilter(time_index) GROUP BY 1, 2 ORDER BY 1 ASC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "🔴🟢 Status dos Postes (ON/OFF)",
      "description": "Estado atual de cada poste — ON ou OFF",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "postgres", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": { "type": "color-text" }
          },
          "mappings": [
            { "type": "value", "options": { "ON":  { "color": "green", "index": 0, "text": "🟢 ON" } } },
            { "type": "value", "options": { "OFF": { "color": "red",   "index": 1, "text": "🔴 OFF" } } }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "ON":  { "color": "green", "text": "🟢 ON" } } },
                  { "type": "value", "options": { "OFF": { "color": "red",   "text": "🔴 OFF" } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT entity_id AS \"Poste\", CASE WHEN ambient_light > 400 THEN 'OFF' ELSE 'ON' END AS \"Status\", CASE WHEN ambient_light > 400 THEN 0 WHEN motion_detected = true THEN 100 ELSE 20 END AS \"Brilho\", ambient_light AS \"Luz Ambiente\", motion_detected AS \"Movimento Detectado\", time_index AS \"Última Atualização\" FROM (SELECT entity_id, ambient_light, motion_detected, time_index, row_number() OVER (PARTITION BY entity_id ORDER BY time_index DESC) as rn FROM mtimdlampservice.etlamp WHERE active = true AND ambient_light IS NOT NULL AND motion_detected IS NOT NULL) t WHERE rn = 1 ORDER BY entity_id ASC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "📊 Brilho Médio por Poste",
      "description": "Média de brilho de cada poste no período selecionado",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "postgres", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlYlRd" },
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 30 },
              { "color": "yellow", "value": 60 },
              { "color": "red",    "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "minVizWidth": 0,
        "minVizHeight": 10,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["mean"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_index AS \"time\", entity_id, CASE WHEN ambient_light > 400 THEN 0 WHEN motion_detected = true THEN 100 ELSE 20 END AS brightness FROM mtimdlampservice.etlamp WHERE $__timeFilter(time_index) AND ambient_light IS NOT NULL AND motion_detected IS NOT NULL ORDER BY time_index ASC",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
